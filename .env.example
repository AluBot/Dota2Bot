# cSpell:disable
PROJECT_NAME=Dota2Bot

# [POSTGRES]
POSTGRES_VPS=
POSTGRES_HOME=

# [STEAM.IRENESTEST]
STEAM_IRENESTEST_USERNAME=
STEAM_IRENESTEST_PASSWORD=

# [STEAM.IRENESBOT]
STEAM_IRENESBOT_USERNAME=
STEAM_IRENESBOT_PASSWORD=

# [TOKENS]
STEAM_API_KEY=

# [WEBHOOKS]
# 🍋d2b_spam
WEBHOOK_ERROR=
WEBHOOK_NOTIFICATION=

# [LOCAL API]
# Shared secret of the local API. The same value goes into the .env of the bots that call it.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
LOCAL_API_KEY=

# [MONITORING]
# Optional: healthchecks.io ping URL, the bot pings it every 5 minutes while it's healthy.
# Only the VPS (a systemd service) pings it, so it's safe to keep the same value in a home .env too.
HEALTHCHECK_URL=

# [SSH]
SSH_PRIVATE_KEY=
SSH_HOST=
SSH_USERNAME=
SSH_PORT=